<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://local.xsd/dbchangelog-4.4.xsd"
                   objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!--
      Import the transactions of the loan-transaction-api (merged into collection-api).
      The dina-db-init-container copies the tables declared in dina_data_import from the loan_transaction database
      as is (including ids) into the target tables, which must still be empty, and marks them as IMPORTED.
    -->
    <changeSet id="199-Add_loan_transaction_data_import" context="schema-change" author="Brandon Andre">
        <createTable tableName="dina_data_import">
            <column autoIncrement="true" name="id" type="SERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_dina_data_import_id"/>
            </column>
            <column name="source_database" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="source_schema" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="source_table" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="target_table" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(50)"/>
            <column name="processed_on" type="timestamptz"/>
        </createTable>

        <sql>
            INSERT INTO dina_data_import (source_database, source_schema, source_table, target_table)
            VALUES ('loan_transaction', 'loan_transaction', 'transaction', 'transaction');
        </sql>
    </changeSet>
</databaseChangeLog>
