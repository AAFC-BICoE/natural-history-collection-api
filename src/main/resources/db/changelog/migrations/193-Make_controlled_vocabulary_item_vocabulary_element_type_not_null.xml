<?xml version="1.1" encoding="UTF-8" standalone="no" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://local.xsd/dbchangelog-4.4.xsd"
                   objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="193-Make_controlled_vocabulary_item_vocabulary_element_type_not_null" context="schema-change" author="cgendreau">
        <!-- Step 1: Set default value for existing NULLs -->
        <update tableName="controlled_vocabulary_item">
            <column name="vocabulary_element_type" value="STRING"/>
            <where>vocabulary_element_type IS NULL</where>
        </update>

        <!-- Step 2: Add NOT NULL constraint -->
        <addNotNullConstraint tableName="controlled_vocabulary_item"
                              columnName="vocabulary_element_type"
                              columnDataType="VARCHAR(50)"/>
    </changeSet>
</databaseChangeLog>
