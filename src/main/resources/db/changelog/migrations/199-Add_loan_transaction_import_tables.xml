<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://local.xsd/dbchangelog-4.4.xsd"
                   objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!--
      Tables used to import the data of the loan-transaction-api (merged into collection-api).
      The dina-db-init-container copies the data of the tables declared in dina_data_import from the loan_transaction
      database into the import tables (same columns, in the same order, as the source tables, no constraints) and marks them as IMPORTED.
      Changeset 200 then migrates the data from the import tables.
    -->
    <changeSet id="199-Add_loan_transaction_import_tables" context="schema-change" author="Brandon Andre">
        <createTable tableName="dina_data_import">
            <column autoIncrement="true" name="id" type="SERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_dina_data_import_id"/>
            </column>
            <column name="source_database" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="source_schema" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="source_table" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="target_table" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(50)"/>
            <column name="processed_on" type="timestamptz"/>
        </createTable>

        <createTable tableName="loan_transaction_transaction">
            <column name="id" type="integer"/>
            <column name="uuid" type="uuid"/>
            <column name="transaction_number" type="varchar(50)"/>
            <column name="other_identifiers" type="text[]"/>
            <column name="material_direction" type="varchar(50)"/>
            <column name="material_to_be_returned" type="boolean"/>
            <column name="_group" type="varchar(50)"/>
            <column name="purpose" type="text"/>
            <column name="transaction_type" type="varchar(50)"/>
            <column name="status" type="varchar(50)"/>
            <column name="opened_date" type="date"/>
            <column name="closed_date" type="date"/>
            <column name="due_date" type="date"/>
            <column name="remarks" type="text"/>
            <column name="created_by" type="varchar(255)"/>
            <column name="created_on" type="timestamptz"/>
            <column name="shipment" type="jsonb"/>
            <column name="managed_attributes" type="jsonb"/>
            <column name="agent_roles" type="jsonb"/>
            <column name="attachment" type="uuid[]"/>
            <column name="material_samples" type="uuid[]"/>
        </createTable>

        <createTable tableName="loan_transaction_managed_attribute">
            <column name="id" type="integer"/>
            <column name="uuid" type="uuid"/>
            <column name="_group" type="varchar(50)"/>
            <column name="type" type="varchar(50)"/>
            <column name="name" type="varchar(50)"/>
            <column name="accepted_values" type="text[]"/>
            <column name="multilingual_description" type="jsonb"/>
            <column name="key" type="varchar(50)"/>
            <column name="created_on" type="timestamptz"/>
            <column name="created_by" type="varchar(250)"/>
        </createTable>

        <createTable tableName="loan_transaction_jv_commit">
            <column name="commit_pk" type="BIGINT"/>
            <column name="author" type="VARCHAR(200)"/>
            <column name="commit_date" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="commit_date_instant" type="VARCHAR(30)"/>
            <column name="commit_id" type="numeric(22, 2)"/>
        </createTable>

        <createTable tableName="loan_transaction_jv_commit_property">
            <column name="property_name" type="VARCHAR(191)"/>
            <column name="property_value" type="VARCHAR(600)"/>
            <column name="commit_fk" type="BIGINT"/>
        </createTable>

        <createTable tableName="loan_transaction_jv_global_id">
            <column name="global_id_pk" type="BIGINT"/>
            <column name="local_id" type="VARCHAR(191)"/>
            <column name="fragment" type="VARCHAR(200)"/>
            <column name="type_name" type="VARCHAR(200)"/>
            <column name="owner_id_fk" type="BIGINT"/>
        </createTable>

        <createTable tableName="loan_transaction_jv_snapshot">
            <column name="snapshot_pk" type="BIGINT"/>
            <column name="type" type="VARCHAR(200)"/>
            <column name="version" type="BIGINT"/>
            <column name="state" type="TEXT"/>
            <column name="changed_properties" type="TEXT"/>
            <column name="managed_type" type="VARCHAR(200)"/>
            <column name="global_id_fk" type="BIGINT"/>
            <column name="commit_fk" type="BIGINT"/>
        </createTable>

        <sql>
            INSERT INTO dina_data_import (source_database, source_schema, source_table, target_table) VALUES
              ('loan_transaction', 'loan_transaction', 'transaction', 'loan_transaction_transaction'),
              ('loan_transaction', 'loan_transaction', 'managed_attribute', 'loan_transaction_managed_attribute'),
              ('loan_transaction', 'loan_transaction', 'jv_commit', 'loan_transaction_jv_commit'),
              ('loan_transaction', 'loan_transaction', 'jv_commit_property', 'loan_transaction_jv_commit_property'),
              ('loan_transaction', 'loan_transaction', 'jv_global_id', 'loan_transaction_jv_global_id'),
              ('loan_transaction', 'loan_transaction', 'jv_snapshot', 'loan_transaction_jv_snapshot');
        </sql>
    </changeSet>
</databaseChangeLog>
