<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://local.xsd/dbchangelog-4.4.xsd"
                   objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="197-Add_more_fields_to_dataset" context="schema-change" author="cgendreau">
        <addColumn tableName="dataset">
            <column name="dataset_version" type="VARCHAR(100)"/>
            <column name="publication_date" type="DATE"/>
            <column name="methods" type="jsonb"/>
            <column name="project" type="jsonb"/>
            <column name="query" type="jsonb"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>