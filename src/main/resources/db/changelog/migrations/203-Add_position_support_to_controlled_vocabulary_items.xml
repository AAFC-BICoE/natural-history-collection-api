<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://local.xsd/dbchangelog-4.4.xsd"
                   objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="a798541e-e2cf-4bd9-b9b2-cb41dde1202a" context="schema-change" author="cgendreau">
        <addColumn tableName="controlled_vocabulary">
            <column name="ordered" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="controlled_vocabulary_item">
            <column name="item_position" type="integer"/>
        </addColumn>
        <addUniqueConstraint
                tableName="controlled_vocabulary_item"
                columnNames="controlled_vocabulary_id, item_position"
                constraintName="unique_position_per_controlled_vocabulary"
                deferrable="true"
                initiallyDeferred="true"/>
    </changeSet>
</databaseChangeLog>
